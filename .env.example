# Set these in your shell before running abe. Each agent reads its key from the environment variable
# named in provider.api_key_env; these are the defaults the intake form fills in. Ollama needs no key.
#
#   PowerShell:  $env:AZURE_OPENAI_API_KEY = "..."
#   bash/zsh:    export AZURE_OPENAI_API_KEY=...
AZURE_OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
